{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kalki Simulator",
  "version": "0.6.0",
  "identifier": "com.kalki.simulator",
  "build": {
    "frontendDist": "../dist-app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kalki Simulator",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob:; media-src blob:; connect-src blob: data: ipc: http://ipc.localhost; font-src 'none'; form-action 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Offline camera-movement simulator for filmmakers",
    "copyright": "Kalki Simulator",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
